[Unit]
Description=Liftlog nightly database backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Replace YOUR_USER with your Linux username (must be in the docker group).
User=YOUR_USER
Environment=LIFTLOG_DIR=/home/YOUR_USER/liftlog
ExecStart=/home/YOUR_USER/liftlog/scripts/backup.sh

# Copy to .env, fill in, then: chmod 600 .env
# Never commit .env (it's in .gitignore).

# One-time Tailscale auth key (admin console > Settings > Keys).
# Single-use, not ephemeral, pre-approved, tagged tag:liftlog.
# After the first successful start you can blank this out; the node's
# identity is saved in ./data/tailscale.
TS_AUTHKEY=

# Generate each with: openssl rand -hex 32
# (hex avoids characters that would break the database URL)
POSTGRES_PASSWORD=
PROXY_SECRET=

# Tailscale logins (the emails shown in the admin console), comma-separated.
ALLOWED_LOGINS=

# Backup failure alerts. Same webhook as Foodlog.
DISCORD_WEBHOOK_URL=
